<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:title="@string/app_name"
            app:titleTextColor="@android:color/white"
            app:menu="@menu/top_menu" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card 1: Công Suất & Trạng Thái Thời Gian Thực -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/title_overview"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvChargingStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ĐANG SẠC"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            android:background="@color/primary_light"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp" />
                    </LinearLayout>

                    <!-- Hero: Phần trăm pin & Công suất W -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvBatteryPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="95%"
                            android:textSize="44sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="48dp"
                            android:background="@color/card_stroke"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CÔNG SUẤT TỨC THỜI"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvLivePowerWatts"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+ 2.51 W"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:textColor="@color/charging" />
                        </LinearLayout>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/pbBatteryLevel"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:progress="95"
                        android:max="100"
                        android:progressTint="@color/primary"
                        android:layout_marginBottom="16dp" />

                    <!-- Grid thông số V, A, Temp -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dòng điện (I)"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />
                            <TextView
                                android:id="@+id/tvCurrentMa"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+581 mA"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Điện áp (U)"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />
                            <TextView
                                android:id="@+id/tvVoltageV"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4.300 V"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nhiệt độ (T)"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />
                            <TextView
                                android:id="@+id/tvTemperature"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="35.9 °C"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Phiên Đo Sạc & Biểu Đồ (Mục riêng biệt) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/layoutSessionCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:animateLayoutChanges="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Phiên Đo Sạc &amp; Biểu Đồ"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvSessionBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SẴN SÀNG"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_secondary"
                            android:background="@color/card_stroke"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ấn bắt đầu đo để mở biểu đồ công suất thời gian thực"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="12dp" />

                    <!-- Timer và Nút Bắt đầu đo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Thời gian sạc:"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvSessionTimer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00:00:00"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnToggleSession"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:text="Bắt đầu đo"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            app:cornerRadius="10dp" />
                    </LinearLayout>

                    <!-- Khung Biểu đồ Canvas (Mặc định GONE, khi ấn đo mới xổ ra!) -->
                    <LinearLayout
                        android:id="@+id/layoutChartContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <com.colorbat.app.PowerChartView
                            android:id="@+id/powerChartView"
                            android:layout_width="match_parent"
                            android:layout_height="160dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Thông Tin Chi Tiết (Đã gộp sức khỏe, chu kỳ và phần cứng) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_bg"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thông Tin Chi Tiết"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvSysfsSource"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dữ liệu đọc từ chip phần cứng &amp; PMIC"
                        android:textSize="13sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp" />

                    <!-- Trạng thái Shizuku PMIC Bridge -->
                    <LinearLayout
                        android:id="@+id/layoutShizukuStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_shizuku_badge"
                        android:padding="10dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tvShizukuStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Quyền Shizuku: Đang kiểm tra..."
                            android:textSize="12sp"
                            android:textColor="@color/text_primary" />

                        <Button
                            android:id="@+id/btnGrantShizuku"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Cấp quyền"
                            android:textSize="11sp"
                            android:textAllCaps="false"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Dòng 1: Tên thiết bị -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Thiết bị:"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/tvDeviceName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OPPO Find X8 (CPH2651)"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <!-- Dòng 2: Tình trạng sức khỏe pin SOH (89% chuẩn ColorOS) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tình trạng sức khỏe (SOH):"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/tvHealthPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="89.0%"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/success" />
                    </LinearLayout>

                    <!-- Dòng 3: Số chu kỳ sạc -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Số chu kỳ sạc (Cycle Count):"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/tvCycleCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="780 lần"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary" />
                    </LinearLayout>

                    <!-- Dòng Cảnh báo chu kỳ sạc (ẩn nếu chưa vượt mức) -->
                    <TextView
                        android:id="@+id/tvCycleAlertWarning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠️ Đã đạt giới hạn chu kỳ sạc cảnh báo!"
                        android:textColor="@color/error"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:layout_marginBottom="10dp" />

                    <!-- Dòng 4: Dung lượng định mức (Rated) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Dung lượng định mức (Rated):"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/tvDesignCapacity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5.520 mAh"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <!-- Dòng 5: Dung lượng tiêu chuẩn (Typical) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Dung lượng tiêu chuẩn (Typical):"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/tvTypicalCapacity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5.630 mAh"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <!-- Dòng 6: Điện tích tức thời (Charge Counter) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Điện tích tích lũy hiện tại:"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/tvChargeCounter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.080 mAh"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Dòng Ngày thay pin (Tùy chọn: ẩn/hiện theo cài đặt) -->
                    <LinearLayout
                        android:id="@+id/rowBatteryReplaced"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ngày thay pin:"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/tvReplacedDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chưa thiết lập"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/secondary" />
                    </LinearLayout>

                    <!-- Dòng Công nghệ pin -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Công nghệ pin:"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/tvTech"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Li-ion (Glacier Si-C)"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Dòng Giao thức sạc -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Giao thức sạc:"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                        <TextView
                            android:id="@+id/tvChargeType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="USB Fast Charging"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Footer -->
            <TextView
                android:id="@+id/tvFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ColorBat v1.1.0"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
