<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/card_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cài Đặt &amp; Tùy Biến"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp" />

    <!-- 1. Cấu hình Pin 2 cell nối tiếp (Đã loại bỏ dòng mô tả theo yêu cầu) -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchDualCell"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cấu hình Pin 2 cell (Dual-Cell)"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:layout_marginBottom="16dp" />

    <!-- 2. Cảnh báo trực tiếp (Live Alert / Fluid Cloud) -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchLiveAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cảnh báo trực tiếp (Live Alert / Fluid Cloud)"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:layout_marginBottom="16dp" />

    <!-- 2. Cảnh báo chu kỳ sạc -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchCycleAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cảnh báo giới hạn chu kỳ sạc"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutCycleLimit"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Giới hạn chu kỳ sạc (Lần)"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCycleLimit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="1000"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 3. Tùy chỉnh dung lượng pin để đo -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Dung lượng pin thiết kế (mAh)"
        android:layout_marginBottom="14dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCustomCapacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="5520"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 4. Ngày thay pin -->
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbBatteryReplaced"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đã từng thay pin mới"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutReplaceDate"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ngày thay pin (VD: 20/10/2026)"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="20dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etReplaceDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:text=""
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelSettings"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hủy"
            android:textColor="@color/text_secondary"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lưu Cài Đặt"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
