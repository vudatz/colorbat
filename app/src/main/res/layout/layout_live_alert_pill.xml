<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pillRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 1. Trạng thái Viên thuốc thu gọn (Dynamic Island / Fluid Cloud Pill) -->
    <LinearLayout
        android:id="@+id/layoutCollapsed"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_live_alert_pill"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:elevation="8dp">

        <TextView
            android:id="@+id/tvPillBolt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textSize="14sp"
            android:textColor="#00E676"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/tvPillPower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.0 W"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textSize="12sp"
            android:textColor="#757575" />

        <TextView
            android:id="@+id/tvPillTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textSize="12sp"
            android:textColor="#E0E0E0" />

        <TextView
            android:id="@+id/tvPillLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#00E676"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- 2. Trạng thái Mở rộng (Expanded Live Alert Card) -->
    <LinearLayout
        android:id="@+id/layoutExpanded"
        android:layout_width="290dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_live_alert_card"
        android:padding="14dp"
        android:visibility="gone"
        android:elevation="12dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ Cảnh Báo Trực Tiếp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#00E676" />

            <TextView
                android:id="@+id/tvExpProtocol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ĐANG SẠC"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#00E676"
                android:background="#1B3828"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvExpClose"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:text="✕"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#A0A0A0" />
        </LinearLayout>

        <!-- Live Power Big -->
        <TextView
            android:id="@+id/tvExpPower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ 0.00 W"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#00E676" />

        <!-- Voltage & Current -->
        <TextView
            android:id="@+id/tvExpMetrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.000 V • 0 mA"
            android:textSize="13sp"
            android:textColor="#E0E0E0"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp" />

        <!-- Details -->
        <TextView
            android:id="@+id/tvExpDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱️ 00:00:00 | +0 mAh | TB: 0.0 W"
            android:textSize="11sp"
            android:textColor="#A0A0A0"
            android:layout_marginBottom="12dp" />

        <!-- Open Button -->
        <Button
            android:id="@+id/btnExpOpenApp"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="Mở ColorBat"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:backgroundTint="#00E676"
            app:cornerRadius="10dp" />
    </LinearLayout>

</FrameLayout>
